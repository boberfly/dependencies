+            return -duration0;
+
+          duration1 = test_run_select(50, 0, 0);
+          if (0 > duration1)
+            return -duration1 + 20;
+
+          duration2 = test_run_select(500, 1, (duration0 + duration1) / 2);
+          if (0 > duration2)
+            return -duration2 + 40;
+
+          if (duration1 * 2 > duration2)
+            { /* Check second time to be sure. */
+              duration2 = test_run_select(500, 1, (duration0 + duration1) / 2);
+              if (0 > duration2)
+                return -duration2 + 60;
+              if (duration1 * 2 > duration2)
+                return 0;
+            }
+        #else
